# ==============================================================================
# OmniBasket AI - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Inference Service (Optional)
# ------------------------------------------------------------------------------
# OpenRouter API Key powers conversational financial intelligence & custom models.
# If omitted or left empty, OmniBasket AI automatically falls back to its built-in
# deterministic financial reasoning engine ("omnibasket-neuro") with zero loss of
# portfolio creation, quoting, simulation, or execution capabilities.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 2. Blockchain & Network Configuration (BNB Smart Chain Mainnet #56)
# ------------------------------------------------------------------------------
# Pinned strictly to BSC Mainnet (Chain ID 56) for on-chain tokenized stock swaps.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=56
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ------------------------------------------------------------------------------
# 3. Public Multi-User Architecture & Security Guardrails
# ------------------------------------------------------------------------------
# IMPORTANT FOR RAILWAY & PRODUCTION DEPLOYMENTS:
# - Production deployments require ZERO Binance API keys or secret keys on the server.
# - Users connect their own Binance Web3 Wallet extension with client-side signing.
# - Unsigned calldata is generated server-side, validated by on-chain EVM simulation,
#   and broadcast solely via the user's browser extension provider.
# - The shared server-side Binance Agentic Wallet (baw) is an optional local/CLI developer
#   tool and MUST remain disabled in public environments to prevent shared wallet access.
ENABLE_AGENTIC_WALLET=false

# ------------------------------------------------------------------------------
# 4. Binance Agentic Wallet (Per-User Session Storage - Optional)
# ------------------------------------------------------------------------------
# In production deployments (NODE_ENV=production), durable per-user session storage
# across container reboots and multi-instance deployments requires:
# 1. BAW_SESSION_STORE_DIR: An absolute path to an attached persistent volume
#    mount (e.g. Railway Volume mounted at /data/baw_sessions). Ephemeral checkout
#    directories are strictly rejected in production to prevent session loss.
# 2. BAW_SESSION_SECRET: A stable, high-entropy secret (at least 32 characters)
#    used to derive AES-256-GCM encryption keys for session state at rest.
# If either variable is omitted or invalid in production, Agentic Wallet fails closed
# and reports UNAVAILABLE, and visitors use Extension Wallet mode for trades.
# BAW_SESSION_STORE_DIR=/data/baw_sessions
# BAW_SESSION_SECRET=at_least_32_characters_high_entropy_secret_here

# Optional Admin Key (for administrative / diagnostic tasks only)
# ADMIN_API_KEY=your_secure_admin_api_key_here
