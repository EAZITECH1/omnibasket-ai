# ==============================================================================
# OmniBasket AI - Environment Configuration
# ==============================================================================

# AI Inference Service
# OpenRouter API Key powers conversational financial intelligence & custom models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Network Configuration
NEXT_PUBLIC_DEFAULT_CHAIN_ID=56
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Agentic Wallet Feature Flag (Disabled by default for public multi-user security)
# Public visitors connect their own Binance Web3 Wallet extension with client-side signing.
# The server-side shared agentic wallet is strictly disabled.
ENABLE_AGENTIC_WALLET=false

# Optional Admin Key (for administrative tasks only)
# ADMIN_API_KEY=your_secure_admin_api_key_here
